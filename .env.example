# Environment Variables — Example
#
# Copy this file to .env and fill in the values.
# NEVER commit the .env file — it's in .gitignore.
#
#   cp .env.example .env
#
# Each app may have its own .env.example with app-specific variables.
# This file contains variables shared across the monorepo.

# ─── General ─────────────────────────────────────────────────────────────────

# Environment: development, staging, production
NODE_ENV=development
APP_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────

# DATABASE_URL=postgres://user:password@localhost:5432/app_dev
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=app_dev
# DATABASE_USER=user
# DATABASE_PASSWORD=password

# ─── Cache ───────────────────────────────────────────────────────────────────

# REDIS_URL=redis://localhost:6379/0

# ─── API ─────────────────────────────────────────────────────────────────────

# API_PORT=3000
# API_HOST=0.0.0.0
# API_BASE_URL=http://localhost:3000

# ─── Authentication ──────────────────────────────────────────────────────────

# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES_IN=1h

# ─── External Services ──────────────────────────────────────────────────────

# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=

# ─── Cloud Provider (uncomment the one you use) ─────────────────────────────

# AWS
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Azure
# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ─── Observability ───────────────────────────────────────────────────────────

# LOG_LEVEL=debug
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=app-name
