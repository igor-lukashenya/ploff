---
import { useTranslations } from '@/i18n';
import { site } from '@/lib/site';

const locale = Astro.currentLocale ?? site.defaultLocale;
const t = useTranslations(locale);
---

<section id="features" class="mx-auto max-w-5xl px-6 py-16">
  <h2 class="text-center text-3xl font-bold">{t.features.title}</h2>
  <p class="mx-auto mt-2 max-w-xl text-center text-slate-600">{t.features.subtitle}</p>
  <div class="mt-10 grid gap-6 sm:grid-cols-3">
    {t.features.items.map((item) => (
      <div class="rounded-xl border border-slate-200 p-6">
        <h3 class="text-lg font-semibold">{item.title}</h3>
        <p class="mt-2 text-slate-600">{item.description}</p>
      </div>
    ))}
  </div>
</section>
