{
  "name": "Ploff Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // .NET SDK (exact version is resolved from global.json)
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" }

    // Node.js and moon are installed by proto from .prototools (see postCreateCommand).
    // Add features for other stacks as needed, e.g.:
    // "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    // "ghcr.io/devcontainers/features/go:1": { "version": "1.22" },
    // "ghcr.io/devcontainers/features/terraform:1": {},
    // "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {}
  },

  // proto-managed tools (moon, node, npm)
  "remoteEnv": {
    "PATH": "/home/vscode/.proto/shims:/home/vscode/.proto/bin:${containerEnv:PATH}"
  },

  // Install proto, then the pinned toolchains and project dependencies
  "postCreateCommand": "curl -fsSL https://moonrepo.dev/install/proto.sh | bash -s -- --no-modify-profile && export PATH=\"$HOME/.proto/shims:$HOME/.proto/bin:$PATH\" && make setup",
  // Uncomment to start the Docker Compose environment on every start:
  // "postStartCommand": "make up",

  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.rulers": [100],
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      },
      "extensions": [
        "EditorConfig.EditorConfig",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker",
        "moonrepo.moon-console",
        "ms-dotnettools.csdevkit",
        "dbaeumer.vscode-eslint"

        // Add extensions for other stacks as needed, e.g.:
        // "ms-python.python",
        // "golang.Go",
        // "hashicorp.terraform",
        // "ms-kubernetes-tools.vscode-kubernetes-tools"
      ]
    }
  },

  "forwardPorts": [
    8080, // sample-api
    3000  // sample-web
  ],

  "remoteUser": "vscode"
}
