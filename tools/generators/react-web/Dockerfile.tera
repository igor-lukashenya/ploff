---
to: '../../infra/docker/Dockerfile.{{ name }}'
---
# Dockerfile for {{ name }} - build with Node, serve with nginx
#
# Build:  docker build -f infra/docker/Dockerfile.{{ name }} -t {{ name }}:latest .
# Run:    docker run -p {{ port }}:8080 -e API_UPSTREAM=http://host.docker.internal:8080 {{ name }}:latest

# Stage 1: Build
FROM node:22-alpine AS build
WORKDIR /app

COPY apps/{{ name }}/package.json apps/{{ name }}/package-lock.json ./
RUN npm ci

COPY apps/{{ name }}/ ./
RUN npm run build

# Stage 2: Serve with nginx (unprivileged image: runs as uid 101, listens on 8080)
FROM nginxinc/nginx-unprivileged:alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/docker/nginx-{{ name }}.conf /etc/nginx/templates/default.conf.template

# Let the entrypoint expose the container's DNS resolver to the nginx config
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1

# Backend that /api/* is proxied to (override at runtime)
ENV API_UPSTREAM={{ api_upstream }}

USER 101

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
