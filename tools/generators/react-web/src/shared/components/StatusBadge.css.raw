.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: capitalize;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.status-badge--healthy {
  background: #d1fae5;
  color: #065f46;
}
.status-badge--healthy .status-dot {
  background: #10b981;
}

.status-badge--unhealthy {
  background: #fee2e2;
  color: #991b1b;
}
.status-badge--unhealthy .status-dot {
  background: #ef4444;
}

.status-badge--degraded {
  background: #fef3c7;
  color: #92400e;
}
.status-badge--degraded .status-dot {
  background: #f59e0b;
}

.status-badge--unknown {
  background: #f3f4f6;
  color: #6b7280;
}
.status-badge--unknown .status-dot {
  background: #9ca3af;
}
