---
to: '../../infra/docker/Dockerfile.{{ name }}'
---
# Dockerfile for {{ name }} - Multi-stage build
#
# Build:  docker build -f infra/docker/Dockerfile.{{ name }} -t {{ name }}:latest .
# Run:    docker run -p {{ port }}:8080 {{ name }}:latest

# ─── Build Stage ─────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project file and restore (layer caching)
COPY apps/{{ name }}/src/{{ name | pascal_case }}/{{ name | pascal_case }}.csproj apps/{{ name }}/src/{{ name | pascal_case }}/
RUN dotnet restore apps/{{ name }}/src/{{ name | pascal_case }}/{{ name | pascal_case }}.csproj

# Copy source and publish (tests are not part of the image)
COPY apps/{{ name }}/src/ apps/{{ name }}/src/
RUN dotnet publish apps/{{ name }}/src/{{ name | pascal_case }}/{{ name | pascal_case }}.csproj -c Release -o /app/publish --no-restore

# ─── Runtime Stage ───────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .

# Run as the non-root 'app' user that ships with the .NET runtime images
USER app

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "{{ name | pascal_case }}.dll"]
