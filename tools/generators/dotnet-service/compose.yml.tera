---
to: '../../infra/docker/compose.{{ name }}.yml'
---
# {{ name }} - loaded automatically by `make up` (see ../../Makefile)
services:
  {{ name }}:
    build:
      context: ../../
      dockerfile: infra/docker/Dockerfile.{{ name }}
    ports:
      - "{{ port }}:8080"
    environment:
      - ASPNETCORE_ENVIRONMENT=Development
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
