---
force: false
---
---
import { useTranslations } from '@/i18n';
import { site } from '@/lib/site';

const locale = Astro.currentLocale ?? site.defaultLocale;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 py-8 sm:flex-row">
    <p class="text-sm text-slate-600">{t.footer.tagline}</p>
    <div class="flex items-center gap-4">
      <a href={site.links.github} target="_blank" rel="noopener" class="text-sm text-slate-500 hover:text-slate-900">
        {t.nav.github}
      </a>
      <p class="text-sm text-slate-500">© {year} {site.name}. {t.footer.rights}</p>
    </div>
  </div>
</footer>
