---
force: false
---
---
import LanguageSwitcher from '@/components/language-switcher.astro';
import { useTranslations } from '@/i18n';
import { site } from '@/lib/site';

const locale = Astro.currentLocale ?? site.defaultLocale;
const t = useTranslations(locale);
const homeUrl = locale === site.defaultLocale ? '/' : `/${locale}/`;
---

<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/80 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href={homeUrl} class="text-lg font-semibold">{site.name}</a>
    <nav class="flex items-center gap-4">
      <a href="#features" class="text-sm text-slate-600 hover:text-slate-900">{t.nav.features}</a>
      <a href={site.links.github} target="_blank" rel="noopener" class="text-sm text-slate-600 hover:text-slate-900">
        {t.nav.github}
      </a>
      <LanguageSwitcher />
    </nav>
  </div>
</header>
