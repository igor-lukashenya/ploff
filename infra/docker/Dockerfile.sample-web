# Stage 1: Build
FROM node:22-alpine AS build
WORKDIR /app

COPY apps/sample-web/package.json apps/sample-web/package-lock.json ./
RUN npm ci

COPY apps/sample-web/ ./
RUN npm run build

# Stage 2: Serve with nginx (unprivileged image: runs as uid 101, listens on 8080)
FROM nginxinc/nginx-unprivileged:alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/docker/nginx-sample-web.conf /etc/nginx/templates/default.conf.template

# Let the entrypoint expose the container's DNS resolver to the nginx config
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1

# Backend that /api/* is proxied to (override at runtime)
ENV API_UPSTREAM=http://sample-api:8080

USER 101

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
