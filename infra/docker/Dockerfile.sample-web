# Stage 1: Build
FROM node:22-alpine AS build
WORKDIR /app

COPY apps/sample-web/package.json apps/sample-web/package-lock.json ./
RUN npm ci

COPY apps/sample-web/ ./
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/docker/nginx-sample-web.conf /etc/nginx/templates/default.conf.template

# Backend that /api/* is proxied to (override at runtime)
ENV API_UPSTREAM=http://sample-api:8080

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
