# Dockerfile for landing - build with Node, serve with nginx
#
# Build:  docker build -f infra/docker/Dockerfile.landing -t landing:latest .
# Run:    docker run -p 3001:8080 landing:latest

# Stage 1: Build
FROM node:22-alpine AS build
WORKDIR /app

COPY apps/landing/package.json apps/landing/package-lock.json ./
RUN npm ci

COPY apps/landing/ ./
RUN npm run build

# Stage 2: Serve with nginx (unprivileged image: runs as uid 101, listens on 8080)
FROM nginxinc/nginx-unprivileged:alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/docker/nginx-landing.conf /etc/nginx/conf.d/default.conf

USER 101

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
